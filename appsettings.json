  "storage": {
    "Mounts": [
      {
        "Path": "/srv/storage",
        "Label": "STORAGE"
      },
      {
        "Path": "/srv/backup",
        "Label": "DQ-BACKUP"
      }
    ],
    "WarningPercent": 80,
    "ErrorPercent": 90,
    "CommandTimeoutSeconds": 5
  },
  "Backups": {
    "RootPath": "/srv/backup",
    "SnapshotsDirectory": "snapshots",
    "LogsDirectory": "logs",
    "WarningAgeDays": 14,
    "ExecutionHistoryLimit": 10,
    "ServiceName": "dreamquest-backup-storage.service",
    "CommandTimeoutSeconds": 5
  }
}