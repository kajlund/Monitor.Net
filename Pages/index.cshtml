@page
@model IndexModel
@{
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>DreamQuest</title>
    <link rel="icon" href="data:,">
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="home-page">
  <main class="home-shell">
      <header class="home-header">
          <div class="header-top">
              <small class="eyebrow">DreamQuest</small>

              <nav class="page-nav" aria-label="Main navigation">
                  <a href="/" class="nav-link active"
                    aria-current="page">Home</a>
                  <a href="/status" class="nav-link">Status</a>
              </nav>
          </div>

          <h1>Welcome</h1>
          <p class="intro">Applications and services on DreamQuest.</p>
      </header>

      <section class="home-section">
            <h2 class="home-section-title">Applications</h2>

            <div class="grid app-grid">
                @foreach (var application in Model.Applications)
                {
                    <a class="card home-app-card"
                    href="@application.PublicUrl"
                    target="_blank"
                    rel="noopener noreferrer">
                        <span class="home-card-icon" aria-hidden="true">
                            @if (!string.IsNullOrWhiteSpace(application.IconUrl))
                            {
                                <img class="app-icon-image"
                                    src="@application.IconUrl"
                                    alt="">
                            }
                            else
                            {
                                <span>@application.Name.Substring(0, 1)</span>
                            }
                        </span>
                        <span class="home-card-copy">
                            <strong>@application.Name</strong>
                            <span class="app-description">
                                @application.Description
                            </span>
                        </span>
                    </a>
                }
            </div>
      </section>
  </main>
</body>
</html>