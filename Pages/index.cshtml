@page
@model IndexModel
@{
  Layout = "_Layout";
  ViewData["Title"] = "DQ Monitor";
  ViewData["BodyClass"] = "home-page";
}

<main class="home-shell">
  <header class="home-header">
    <div class="header-top">
      <small class="eyebrow">DreamQuest</small>

      @await Html.PartialAsync("_MainNav", "Home")
    </div>

    <h1>Welcome</h1>
    <p class="intro">Applications and services on DreamQuest.</p>
  </header>

  <section class="home-section">
    <h2 class="home-section-title">Applications</h2>

    <div class="grid app-grid">
      @foreach (var application in Model.Applications)
      {
        <a class="card home-app-card" href="@application.PublicUrl" target="_blank" rel="noopener noreferrer">
          <span class="home-card-icon" aria-hidden="true">
            @if (!string.IsNullOrWhiteSpace(application.IconUrl))
            {
              <img class="app-icon-image" src="@application.IconUrl" alt="">
            }
            else
            {
              <span>@application.Name.Substring(0, 1)</span>
            }
          </span>
          <span class="home-card-copy">
            <strong>@application.Name</strong>
            <span class="app-description">
              @application.Description
            </span>
          </span>
        </a>
      }
    </div>
  </section>

  <section class="home-section">
    <h2 class="home-section-title">Today</h2>

    <div class="widgets">
      <article class="widget-card">
        <div class="widget-header">
          <i class="ph ph-quotes" aria-hidden="true"></i>
          <span class="widget-label">Quote of the day</span>
        </div>

        @if (Model.Quote is { } quote)
        {
          <blockquote class="quote-content">@quote.Content</blockquote>

          @if (!string.IsNullOrWhiteSpace(quote.Author))
          {
            <cite class="quote-author">— @quote.Author</cite>
          }
        }
        else
        {
          <p class="weather-desc">Quote unavailable.</p>
        }
      </article>

      <article class="widget-card">
        <div class="widget-header">
          <i class="ph @Model.WeatherCondition.Icon" aria-hidden="true"></i>
          <span class="widget-label">Weather · Pietarsaari</span>
        </div>

        @if (Model.Weather?.Temperature is double temperature)
        {
          <div class="weather-info">
            <span class="weather-temp">@(temperature.ToString("F0")) °C</span>
            <span class="weather-desc">@Model.WeatherCondition.Description</span>
          </div>
        }
        else
        {
          <p class="weather-desc">Current weather unavailable.</p>
        }

        <a class="weather-desc" href="https://open-meteo.com/">Weather data by Open-Meteo</a>
      </article>
    </div>
  </section>
</main>
