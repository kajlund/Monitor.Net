@model string

<nav class="page-nav" aria-label="Main navigation">
  <a href="/" class="nav-link @(Model == "Home" ? "active" : "")" aria-current="@(Model == "Home" ? "page" : null)">
    Home
  </a>

  <a href="/status" class="nav-link @(Model == "Status" ? "active" : "")"
     aria-current="@(Model == "Status" ? "page" : null)">
    Status
  </a>

  <a href="/backups" class="nav-link @(Model == "Backups" ? "active" : "")"
     aria-current="@(Model == "Backups" ? "page" : null)">
    Backups
  </a>
  @if (User.Identity?.IsAuthenticated == true)
  {
    <form method="post" action="/logout">
      @Html.AntiForgeryToken()
      <button type="submit" class="nav-link">Sign out</button>
    </form>
  }
  else
  {
    <a href="/login" class="nav-link">Admin login</a>
  }
</nav>